# Optional overrides for docker-compose.yml (copy to .env in the repository root).
# Every value has a working default; change secrets for anything beyond local evaluation.

API_PORT=3000
MCP_PORT=3001
POSTGRES_PORT=5433
LOG_LEVEL=info

# pgAdmin (only started with: docker compose --profile tools up -d pgadmin)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@zidni.com
PGADMIN_PASSWORD=admin

JWT_SECRET=local-compose-secret-change-me-0123456789abcdef
JWT_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:3000

SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@zidni.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_EMAIL=user@zidni.local
SEED_USER_PASSWORD=User@123456
SEED_CATALOG_AGENT_KEY=zk_catalog1_dev-catalog-agent-secret-change-me
SEED_READONLY_AGENT_KEY=zk_readonl1_dev-readonly-agent-secret-change-me
