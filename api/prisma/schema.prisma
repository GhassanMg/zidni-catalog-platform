// Database schema for the catalog platform.
// CHECK constraints and the audit-log immutability trigger live in the SQL migration
// (Prisma cannot express them in the schema language).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm backs the GIN indexes used by case-insensitive "contains" search on names.
  extensions = [pg_trgm]
}

enum Role {
  ADMIN
  USER
}

enum Permission {
  PRODUCTS_READ
  PRODUCTS_WRITE
  CATEGORIES_READ
  CATEGORIES_WRITE
  AUDIT_READ
  API_CLIENTS_MANAGE
}

enum ActorType {
  USER
  AGENT
  ANONYMOUS
}

enum Channel {
  REST
  MCP
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  UPDATE_LINKS
  SET_LINKS
  REVOKE
}

enum AuditResource {
  PRODUCT
  CATEGORY
  USER
  API_CLIENT
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  name         String   @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(100)
  role         Role     @default(USER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  apiClients ApiClient[]

  @@map("users")
}

/// Machine identities (AI agents). Authenticated by API key; carry an explicit permission list.
model ApiClient {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique @db.VarChar(100)
  keyPrefix   String       @unique @map("key_prefix") @db.VarChar(16)
  /// SHA-256 (hex) of the full API key. The plaintext key is shown once at creation.
  keyHash     String       @map("key_hash") @db.Char(64)
  permissions Permission[]
  expiresAt   DateTime?    @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime?    @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt  DateTime?    @map("last_used_at") @db.Timestamptz(3)
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@map("api_clients")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  /// Derived from name (lower-case, hyphenated). Unique => names are unique case/spacing-insensitively.
  slug        String   @unique @db.VarChar(120)
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products ProductCategory[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "categories_name_trgm_idx")
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(200)
  description String   @db.Text
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  categories ProductCategory[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([createdAt])
  @@map("products")
}

/// Many-to-many join. Composite PK prevents duplicate links; deleting either side removes the link only.
model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

/// Append-only audit trail. No foreign keys on purpose: entries must outlive the actor and the resource.
model AuditLog {
  id           String        @id @default(uuid()) @db.Uuid
  action       AuditAction
  resourceType AuditResource @map("resource_type")
  resourceId   String?       @map("resource_id") @db.VarChar(64)
  status       AuditStatus
  actorType    ActorType     @map("actor_type")
  actorId      String?       @map("actor_id") @db.Uuid
  actorLabel   String?       @map("actor_label") @db.VarChar(254)
  channel      Channel
  requestId    String?       @map("request_id") @db.VarChar(128)
  ipAddress    String?       @map("ip_address") @db.VarChar(64)
  /// { before, after } snapshots of the affected resource.
  changes      Json?
  /// Operation details: link diffs, MCP tool name, HTTP status / error for failures.
  metadata     Json?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([resourceType, resourceId])
  @@index([actorType, actorId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("audit_logs")
}
