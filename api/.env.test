# Used by the e2e / MCP test suites. Points at a dedicated database so tests never touch dev data.
NODE_ENV=test
LOG_LEVEL=silent
DATABASE_URL=postgresql://zidni:zidni@localhost:5432/zidni_test?schema=public
JWT_SECRET=test-secret-test-secret-test-secret-0123456789
JWT_TTL_SECONDS=900
BCRYPT_ROUNDS=4
SWAGGER_ENABLED=false
THROTTLE_ENABLED=false
