# Copy to api/.env for local (non-Docker) development.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Matches the postgres service in docker-compose.yml (exposed on localhost:5433)
DATABASE_URL=postgresql://zidni:zidni@localhost:5433/zidni?schema=public

# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_TTL_SECONDS=900
JWT_ISSUER=zidni-catalog-api
JWT_AUDIENCE=zidni-catalog-clients

BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
TRUST_PROXY=false

THROTTLE_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Seed data (development only). Agent keys must match zk_<8 alnum>_<32+ url-safe chars>.
SEED_ADMIN_EMAIL=admin@zidni.local
SEED_ADMIN_PASSWORD=Admin#12345
SEED_USER_EMAIL=user@zidni.local
SEED_USER_PASSWORD=User#123456
SEED_CATALOG_AGENT_KEY=zk_catalog1_dev-catalog-agent-secret-change-me
SEED_READONLY_AGENT_KEY=zk_readonl1_dev-readonly-agent-secret-change-me
