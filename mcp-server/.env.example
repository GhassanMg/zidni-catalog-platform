# Base URL of the catalog REST API (including the /api/v1 prefix)
API_BASE_URL=http://localhost:3000/api/v1

# stdio: one agent per process, key read from AGENT_API_KEY.
# http:  Streamable HTTP on MCP_HTTP_PORT; each request must carry its own agent key
#        (Authorization: Bearer zk_... or X-API-Key).
MCP_TRANSPORT=stdio
AGENT_API_KEY=zk_catalog1_dev-catalog-agent-secret-change-me
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3001

MCP_REQUEST_TIMEOUT_MS=10000
# Only advertise tools the agent's key is allowed to use (the API enforces regardless).
MCP_HIDE_UNPERMITTED_TOOLS=true
